{
  "name": "khub-boilerplate",
  "version": "1.0.0",
  "description": "Reusable vanilla PWA starter — multi-file, no build step, installable via GitHub Pages",
  "private": true,
  "scripts": {
    "lint":        "eslint js/**/*.js sw.js",
    "lint:fix":    "eslint js/**/*.js sw.js --fix",
    "format":      "prettier --write \"**/*.{html,css,js,json,md}\" --ignore-path .prettierignore",
    "format:check":"prettier --check \"**/*.{html,css,js,json,md}\" --ignore-path .prettierignore",
    "check":       "npm run lint && npm run format:check"
  },
  "devDependencies": {
    "eslint":   "^8.57.0",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=18"
  }
}
