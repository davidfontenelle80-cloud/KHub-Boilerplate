# .env.prod — Production environment
# These values are READ BY js/config.js at runtime (not injected at build time).
# In vanilla JS there is no build step, so these are documentation only.
# config.js auto-detects dev vs prod from location.hostname.
#
# When running on GitHub Pages (or any non-localhost host):
#   - KHub.Config.env      = "production"
#   - KHub.Config.isProd   = true
#   - Error stack traces   = hidden from users
#   - Error demo button    = hidden
#   - Console logs         = errors only

KHUB_ENV=production
KHUB_APP_NAME=KHub App
KHUB_LOG_LEVEL=error
KHUB_FEATURES_AUTH=false
KHUB_FEATURES_FIREBASE=false
